# Copy to .env and fill values. Boot fails if any required key is missing or invalid (see src/config/env.ts).

# --- Postgres (required) ---
# Railway injects this when you attach Postgres. Local: docker-compose or your instance.
DATABASE_URL=postgres://user:password@localhost:5432/driff

# --- GitHub App (required) ---
# App ID from GitHub → Settings → Developer settings → GitHub Apps → your app.
GITHUB_APP_ID=
# Contents of the .pem private key. Preserve newlines: use \n between lines inside quotes, or paste multiline PEM.
GITHUB_APP_PRIVATE_KEY=
# Same secret configured on the GitHub App webhook (used for X-Hub-Signature-256).
GITHUB_WEBHOOK_SECRET=

# --- Anthropic (required) ---
ANTHROPIC_API_KEY=

# --- Notion — PR database (required) ---
# Internal integration token; share the PR database with that integration.
NOTION_TOKEN=
# Database ID where merged PR pages are created (not the page URL).
NOTION_DATABASE_ID=

# --- Notion + GitHub — iOS release / changelog (optional block) ---
# If NOTION_RELEASES_DATABASE_ID is set, you MUST also set RELEASE_INFO_PLIST_PATH and RELEASE_VERSION_BRANCH.
# Second Notion database for release pages (changelog). Omit entire block to disable Phase 2 release jobs.
# NOTION_RELEASES_DATABASE_ID=
# Path to Info.plist in the iOS repo, relative to repo root (e.g. Info.plist or App/Info.plist).
# RELEASE_INFO_PLIST_PATH=Info.plist
# Branch name only (no refs/heads/), e.g. develop. Push to this branch can enqueue process_release when plist/pbx paths match.
# RELEASE_VERSION_BRANCH=develop
# Optional: only owner/name triggers release push handling (e.g. acme/ios-app). Omit to allow any installed repo.
# RELEASE_MONITORED_REPO=owner/ios-app
# Optional: e.g. MyApp.xcodeproj/project.pbxproj — use when Info.plist uses $(MARKETING_VERSION) / $(CURRENT_PROJECT_VERSION)
# or when version bumps happen only in the Xcode project file.
# RELEASE_PROJECT_PBXPROJ_PATH=MyApp.xcodeproj/project.pbxproj

# --- App server (optional; defaults shown) ---
PORT=3000
LOG_LEVEL=info
NODE_ENV=development

# --- PR summarization filter (optional) ---
# Comma-separated base branch names (pull_request.base.ref). If unset or empty, every merged PR is summarized.
# Example: develop or develop,release
# PR_SUMMARY_BASE_BRANCHES=develop
