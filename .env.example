# Postgres
DATABASE_URL=postgres://user:password@localhost:5432/driff

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Anthropic
ANTHROPIC_API_KEY=

# Notion
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Optional: iOS release notes (see AGENTS.md Phase 2). Requires plist path + branch when set.
# NOTION_RELEASES_DATABASE_ID=
# RELEASE_INFO_PLIST_PATH=Info.plist
# Optional: when Info.plist uses $(MARKETING_VERSION), read real versions from the Xcode project file.
# RELEASE_PROJECT_PBXPROJ_PATH=MyApp.xcodeproj/project.pbxproj
# RELEASE_VERSION_BRANCH=develop
# RELEASE_MONITORED_REPO=owner/ios-app

# App
PORT=3000
LOG_LEVEL=info
NODE_ENV=development

# Optional: only summarize merged PRs whose base branch is one of these (comma-separated, e.g. develop).
# If unset or empty, all merged PRs are summarized.
# PR_SUMMARY_BASE_BRANCHES=develop
