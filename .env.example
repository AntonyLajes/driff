# Copy to .env and fill values. Boot fails if any required key is missing or invalid (see src/config/env.ts).

# --- Postgres (required) ---
# Railway injects this when you attach Postgres. Local: docker-compose or your instance.
DATABASE_URL=postgres://user:password@localhost:5432/driff

# --- GitHub App (required) ---
# App ID from GitHub → Settings → Developer settings → GitHub Apps → your app.
GITHUB_APP_ID=
# Contents of the .pem private key. Preserve newlines: use \n between lines inside quotes, or paste multiline PEM.
GITHUB_APP_PRIVATE_KEY=
# Same secret configured on the GitHub App webhook (used for X-Hub-Signature-256).
GITHUB_WEBHOOK_SECRET=

# --- Anthropic (required) ---
ANTHROPIC_API_KEY=

# --- Notion (secrets in env; database IDs can move to Postgres) ---
# Internal integration token; share the PR database with that integration.
NOTION_TOKEN=
# Fallback when `workspace_settings.notion_pr_database_id` is empty. Prefer inserting a row in `workspace_settings`
# (see AGENTS.md) so you do not need NOTION_DATABASE_ID / release env vars here.
NOTION_DATABASE_ID=

# Optional fallbacks for the same columns as `workspace_settings` (used when the DB row omits a value).
# NOTION_RELEASES_DATABASE_ID=
# RELEASE_INFO_PLIST_PATH=Info.plist
# RELEASE_VERSION_BRANCH=develop
# RELEASE_MONITORED_REPO=
# RELEASE_PROJECT_PBXPROJ_PATH=
# RELEASE_COMPARE_ROOT_SHA=
# Preferred: project type + single version file (same semantics as workspace_settings columns).
# RELEASE_PROJECT_KIND=react_native_expo
# RELEASE_VERSION_FILE_PATH=app.json
# Legacy fallbacks (ignored when unified pair above is set):
# RELEASE_INFO_PLIST_PATH=Info.plist
# RELEASE_PROJECT_PBXPROJ_PATH=
# RELEASE_EXPO_APP_CONFIG_PATH=app.config.js

# --- Google Sign-In only (optional; set all five together or omit all five) ---
# From Google Cloud Console (single OAuth 2.0 Client ID → Web application):
#   1) console.cloud.google.com → your project → APIs & Services → Credentials
#   2) Configure the OAuth consent screen (internal or external) if not done yet
#   3) Create credentials → OAuth client ID → Application type: Web application
#   4) Authorized redirect URIs — add exactly (port = Fastify API):
#        http://localhost:3000/auth/google/callback
#   5) Copy "Client ID" and "Client secret" into the two variables below.
# GOOGLE_OAUTH_CLIENT_ID=....apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-...
# Not from Google — your own secret to sign session JWTs (min 32 chars), e.g. openssl rand -base64 48
# AUTH_JWT_SECRET=
# Public API base URL (must match the redirect URI prefix you registered in Google):
# AUTH_PUBLIC_URL=http://localhost:3000
# Where the browser returns after login (Vite dev server):
# FRONTEND_URL=http://localhost:5173

# --- App server (optional; defaults shown) ---
PORT=3000
LOG_LEVEL=info
NODE_ENV=development
# Browser origins allowed to call the JSON API (comma-separated). When unset, development uses reflective CORS for local tools such as Vite; production keeps CORS off until you set explicit origins.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- PR summarization filter (optional) ---
# Comma-separated base branch names (pull_request.base.ref). If unset or empty, every merged PR is summarized.
# Example: develop or develop,release
# PR_SUMMARY_BASE_BRANCHES=develop
